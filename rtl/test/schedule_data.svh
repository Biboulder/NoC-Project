      9: SCHED_ROW_NODE = 4;
      10: SCHED_ROW_NODE = 5;
      11: SCHED_ROW_NODE = 5;
      12: SCHED_ROW_NODE = 5;
      13: SCHED_ROW_NODE = 6;
      14: SCHED_ROW_NODE = 6;
      15: SCHED_ROW_NODE = 7;
      16: SCHED_ROW_NODE = 7;
      17: SCHED_ROW_NODE = 7;
      18: SCHED_ROW_NODE = 8;
      19: SCHED_ROW_NODE = 8;
      default: SCHED_ROW_NODE = -1;
    endcase
  endfunction

