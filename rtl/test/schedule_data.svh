// Schedule table for the mesh test bench (tb_schedule).
// Source: schedules/schedule_row.sched
// grid 3x3, frame 14 cycles, 20 rows, 72 alternatives
// Regenerate: python3 -m routing export-sv <schedule.sched> -o rtl/test/schedule_data.svh
// Node/dest values are 0-based SV mesh indices (schedule labels - 1);
// routes are zero-padded with LOCAL to 4 fields (router_pkg HEADER=12).
// Each 'array' is a constant function (iverilog cannot elaborate
// unpacked-array localparam literals); index i -> value i, as in
// the source schedule.
package tb_schedule_pkg;
  import router_pkg::*;

  localparam int SCHED_GRID = 3;
  localparam int SCHED_FRAME = 14;
  localparam int SCHED_ROWS = 20;
  localparam int SCHED_ALTS = 72;
  localparam int SCHED_MAX_ALTS = 7;
  localparam int SCHED_MAX_CLOCK = 11;

  function automatic int SCHED_ROW_NODE(input int i);
    case (i)
      0: SCHED_ROW_NODE = 0;
      1: SCHED_ROW_NODE = 0;
      2: SCHED_ROW_NODE = 1;
      3: SCHED_ROW_NODE = 1;
      4: SCHED_ROW_NODE = 2;
